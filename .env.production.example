# PostgreSQL Production Credentials
POSTGRES_USER=quantlab_prod
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=quantlab_prod

# API Production Configuration
# FRONTEND_URL is required by CORS. 
# On this first deployment, it will be the public IP of your EC2 (e.g., http://54.123.45.67).
# Later, you can update this to your HTTPS domain name (e.g., https://yourdomain.com).
FRONTEND_URL=http://your-ec2-public-ip

# JWT Secrets (Must be at least 32 characters)
# Generate these securely (e.g., using `openssl rand -base64 32`)
JWT_ACCESS_SECRET=generate_a_secure_random_string_here_32_chars_min
JWT_REFRESH_SECRET=generate_another_secure_random_string_here_32_chars_min
