{
  "name": "@quantlab/api",
  "private": true,
  "version": "0.1.0",
  "description": "QuantLab backend - Express + TypeScript REST API",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
