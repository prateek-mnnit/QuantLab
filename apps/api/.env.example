NODE_ENV=development
PORT=4000

# Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://quantlab:quantlab_dev_password@localhost:5432/quantlab?schema=public"

# Origin allowed to call this API - must match where apps/web is served from.
FRONTEND_URL="http://localhost:5173"

# JWT secrets - generate real random values for anything beyond local dev,
# e.g. `openssl rand -base64 48`. Never reuse these example values.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-32-chars-min"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-32-chars-min"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS=30
